PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pestshield?retryWrites=true&w=majority
JWT_SECRET=replace_this_with_a_long_random_string
CLIENT_URL=http://localhost:5173

# First admin. Created once on server start, only if no admin exists yet.
# Public registration can never create an admin.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
